<erl>
	%-include("msg_func.hrl").
	 
	test_reply() ->
	io_lib:format("{\"title\": \"post\", \"post\": ~p }", ["test post"]). 

	out(Arg) ->   
		{ehtml, test_reply()}.

</erl>
