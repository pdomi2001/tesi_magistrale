<erl>
	%-include("msg_func.hrl").
	 
	test_reply(Arg) ->
		case method(Arg) of
			'GET' -> 	io_lib:format("{\"title\": \"Arrivato messaggio in GET\", \"method\": \"get\", \"result\": ~p }", ["test get"]);

			'POST' -> 	io_lib:format("{\"title\": \"Arrivato messaggio in POST\", \"method\": \"POST\", \"result\": ~p }", ["[{\"prova\": \"valore\", \"prova2\": \"valore2\" }]"])
			%'POST' -> 	io_lib:format("{\"title\": \"Arrivato messaggio in POST\", \"method\": \"POST\", \"result\": ~p }", [Arg#arg.clidata])
			%'POST' ->	io_lib:format("{\"title\": \"Arrivato messaggio in post\", \"method\": \"post\",  \"post\": ~p }", [rfc4627:decode("[{\"prova\": \"valore\"; \"prova2\": \"valore2\" }]")])
			%'POST' ->	
			%			data = Arg#arg.clidata, %rfc4627:decode(Arg#arg.clidata),
			%			io_lib:format("{\"title\": \"Arrivato messaggio in post\", \"method\": \"post\",  \"post\": ~p }", ["[{\"prova\": \"valore\"; \"prova2\": \"valore2\" }]"])
		end
	.
	
	method(Arg) ->  Rec = Arg#arg.req,   Rec#http_request.method. 

	get_data(Arg) ->  
		{ok, Json, _}  = rfc4627:decode(Arg#arg.clidata),
		io:format("~n~p:~p POST request ~p~n", [?MODULE, ?LINE, Json]).

	out(Arg) ->   
		{ehtml, test_reply(Arg)}.
		%{ehtml, f("{\"title\": \"title\", \"method\": \"~p\" }", [method(Arg)])}.  
		%msg_func:test_reply(Arg).
		%{ehtml, f("{\"title\": \"title\", \"post\": \"~p\" }", [yaws_api:parse_post(Arg)])}.  

</erl>
