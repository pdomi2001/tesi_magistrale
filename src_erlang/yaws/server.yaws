<erl>
 
	test_reply(Arg) ->
		case method(Arg) of
			'GET' -> 	io_lib:format("{\"title\": \"Arrivato messaggio in GET\", \"method\": \"get\", \"result\": ~p }", ["test get"]);

			'POST' -> 	io_lib:format("{\"title\": \"Arrivato messaggio in POST\", \"method\": \"POST\", \"result\": ~p }", [get_data(Arg)])
		end
	.
	
	method(Arg) ->  
		Rec = Arg#arg.req,   Rec#http_request.method
		. 

	processa_comandi('POST', Arg) ->
		%Result = "risultato",
		Parametri = #{
			<<"title">> => <<"Arrivato messaggio in POST">>,
			<<"method">> => <<"POST">>,
			<<"result">> => 
				try 
					get_data(Arg)
				catch
					_:_ -> <<"result_error">>
				end,
			<<"risposta">> => 
				try 
					process_data(Arg)
				catch
					_:_ -> <<"process_data_error">>
				end
		},
		Result = json:encode(Parametri),
		%Result = io_lib:format("{\"title\": \"Arrivato messaggio in POST\", \"method\": \"POST\", \"result\": ~p }", [get_data(Arg)]),
		Result
		;

	processa_comandi('GET', _Arg) ->
		%equivalente con le mappe di quello fatto fino ad ora
		Parametri = #{
			<<"title">> => <<"Arrivato messaggio in GET">>,
			<<"method">> => <<"GET">>,
			<<"result">> => <<"test_get">>
		},
		Result = json:encode(Parametri),
		%Result = io_lib:format("{\"title\": \"Arrivato messaggio in GET\", \"method\": \"get\", \"result\": ~p }", ["test_get"]),
		Result
		;
	
	processa_comandi(Method, Arg) ->
		Result = io_lib:format("Metodo non gestito: ~p", [Method]),
		Result
		.

	get_data(Arg) ->
		Clidata = iolist_to_binary(Arg#arg.clidata),
		case json:decode(Clidata) of
			List when is_list(List) -> List;
			Map when is_map(Map) -> Map;
			_ -> #{<<"error">> => <<"formato_sconosciuto">>}
		end.	

			
	process_data(Arg) ->
		%Clidata = get_data(Arg),
		Clidata = iolist_to_binary(Arg#arg.clidata),
		Parametri =
			try 
				json:decode(Clidata)
			catch
				_:_ -> #{<<"msg_type">> => <<"decode_json_problem">>} 
			end,
		
		Tipo_Messaggio = maps:get(<<"msg_type">>, Parametri, <<"default_value">>),
		Msg_content = maps:get(<<"msg_content">>, Parametri, <<"default_value_content">>),
		Iterazioni = maps:get(<<"numero_iterazioni">>, Msg_content, 0),
		IterazioniBinary = if
			is_integer(Iterazioni) -> integer_to_binary(Iterazioni);
			is_binary(Iterazioni)  -> Iterazioni;
			true           -> <<"iterazioni_non_valido">>
		end,
%		#{<<"msg_content">> := Msg_content}= Parametri,
%		#{<<"numero_iterazioni">> := Iterazioni} = Msg_content,
		
		Prefisso = <<"result successful ">>,
		case Tipo_Messaggio of
			<<"test_message">> ->
				Parametri_res = #{
					<<"result_type">> => <<"test_result">>,
					<<"result_content">> => <<Prefisso/binary, IterazioniBinary/binary>>
					%<<"result_content">> => <<Prefisso/binary, (integer_to_binary(Iterazioni))/binary>>
				};
			<<"test_message_m">> ->
				% Salva la richiesta in Mnesia
				Id = inserisci_richiesta(Tipo_Messaggio, Msg_content),
				Parametri_res = #{
					<<"result_type">> => <<"test_result_m">>,
					<<"result_content">> => #{
							<<"result_desc">> => <<Prefisso/binary>>,
							<<"id_message">> => integer_to_binary(Id)
							}
				},
				Parametri_res;
			<<"test_message_r">> ->
				% Leggi la richiesta in Mnesia
				Id = maps:get(<<"id">>, Msg_content, 0),
				IdBinary = if
					is_integer(Id) -> integer_to_binary(Id);
					is_binary(Id)  -> Id;
					true           -> <<"id_non_valido">>
				end,
				IdNum = if
					is_integer(Id) -> Id;
					is_binary(Id)  -> binary_to_integer(Id);
					true           -> 0
				end,
				case leggi_richiesta(IdNum) of
					{ok, Result} ->
						Parametri_res = #{
						<<"result_type">> => <<"test_result_r">>,
						<<"result_content">> => #{
								<<"result_desc">> => <<"reading_result">>,
								<<"content">> => record_to_map(Result)
								}
						};
					{error, not_found} ->
						Parametri_res = #{
						<<"result_type">>  => <<"error">>,
						<<"result_content">> => #{
								<<"result_desc">> => <<"id non trovato">>,
								<<"content">> => IdBinary
								}
						};
					{error, Reason} ->
						Parametri_res = #{
						<<"result_type">>  => <<"error">>,
						<<"result_content">> => #{
								<<"result_desc">> => <<"id non trovato">>,
								<<"content">> => list_to_binary(io_lib:format("~p", [Reason]))
								}
						}
				end,
				Parametri_res;
			<<"elenco_record_mnesia">> ->
				Parametri_res = #{
					<<"result_type">> => <<"elenco_tabella_mnesia_result">>,
					<<"result_content">> => leggi_tabella_mnesia()
				};
			<<"registra_postazione">> ->
				Parametri_res = #{
					<<"result_type">> => <<"registration_result">>,
					<<"result_content">> => <<"registration successful">>
				};
			_ -> 
				Parametri_res = #{
					<<"result_type">> => <<"not_found">>,
					<<"result_content">> => Tipo_Messaggio
				}
		end,
		Parametri_res
		.

%	get_data2(Arg) ->  
%		{ok, Json, _}  = rfc4627:decode(Arg#arg.clidata),
%		io:format("~n~p:~p POST request ~p~n", [?MODULE, ?LINE, Json])
%		.

	decode_Json(JsonRaw) ->
		Mappa = 
		try
			json:decode(JsonRaw)
		catch
			%error:Reason ->
				%io:format("Errore durante la decodifica JSON: ~p~n", [Reason]),
				%{error, #{<<"errore">> => <<"json_malformato">>} }
			_:_ -> #{<<"msg_type">> => <<"errore">>}
		end,
		{ok, Mappa}
		.

	out(Arg) ->
		Method = method(Arg),
		Risultato = try
			processa_comandi(Method, Arg)
		catch
			_ -> json:encode(#{
			<<"title">> => <<"Arrivato messaggio in POST">>,
			<<"method">> => <<"POST">>
		})
		end,
		%Risultato = "processa_comandi(Method, Arg)",
		%{ehtml, Risultato}
		
		%% Definiamo l'header CORS
		% Sostituisci "*" con "https://tuosito.com" per maggiore sicurezza
		ACAO = {header, {"Access-Control-Allow-Origin", "*"}},
		
		%% Altri header comuni per le API
		ContentType = {header, {"Content-Type", "application/json"}},
		% Torno gli header per evitare ACAO
		[
			ACAO,
			ContentType,		
			{content, "application/json", Risultato}
		]
		.   

	% gestione del Database
	% Definizione del record
	-record(richiesta, {
		id,           % chiave univoca
		msg_type,     % tipo messaggio
		payload,      % dati della richiesta
		stato,        % in_attesa | in_elaborazione | completata
		timestamp     % quando è arrivata
	}).
	
	% INSERT - salva una nuova richiesta
inserisci_richiesta(MsgType, Payload) ->
    Id = erlang:unique_integer([positive]),
    R = #richiesta{
        id        = Id,
        msg_type  = MsgType,
        payload   = Payload,
        stato     = in_attesa,
        timestamp = erlang:localtime()
    },
    mnesia:transaction(fun() -> mnesia:write(R) end),
    Id.

% READ - leggi una richiesta per id
leggi_richiesta(Id) ->
    case mnesia:transaction(fun() -> mnesia:read(richiesta, Id) end) of
        {atomic, [R]} ->
            % Trovato
            {ok, R};
        {atomic, []} ->
            % Non trovato
            {error, not_found};
        {aborted, Reason} ->
            % Errore Mnesia
            {error, Reason}
    end.
    
leggi_richiesta_2(Id) ->
    try mnesia:dirty_read(richiesta, Id) of
        [R] -> {ok, R};
        []  -> {error, not_found}
    catch
        _:Reason -> {error, Reason}
    end. 
    
leggi_richiesta_3(Id) ->
    MatchPattern = [{
        {richiesta, Id, '_', '_', '_', '_'},
        [],
        ['$_']
    }],
    case mnesia:transaction(fun() -> mnesia:select(richiesta, MatchPattern) end) of
        {atomic, [R]} -> {ok, R};
        {atomic, []}  -> {error, not_found};
        {aborted, Reason} -> {error, Reason}
    end.    
       

% UPDATE - aggiorna lo stato
aggiorna_stato(Id, NuovoStato) ->
    mnesia:transaction(fun() ->
        [R] = mnesia:read(richiesta, Id),
        mnesia:write(R#richiesta{stato = NuovoStato})
    end).

% DELETE - rimuovi una richiesta completata
elimina_richiesta(Id) ->
    mnesia:transaction(fun() ->
        mnesia:delete({richiesta, Id})
    end).

% Legge tutti i record della tabella
leggi_tabella_mnesia() ->
    {atomic, Records} = mnesia:transaction(fun() ->
        mnesia:select(richiesta, [{'_', [], ['$_']}])
    end),
    % Converte ogni record in una mappa
    Lista = lists:map(fun(R) -> record_to_map(R) end, Records),
    #{
        <<"result">>  => <<"ok">>,
        <<"count">>   => length(Lista),
        <<"records">> => Lista
    }.
record_to_map(R) ->
    #{
        <<"id">>        => element(2, R),
        <<"msg_type">>  => element(3, R),
        <<"payload">>   => element(4, R),
        <<"stato">>     => atom_to_binary(element(5, R), utf8),
        <<"timestamp">> => list_to_binary(io_lib:format("~p", [element(6, R)]))
    }.
</erl>
