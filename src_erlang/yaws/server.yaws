<erl>
	%-include("msg_func.hrl").
	 
	test_reply(Arg) ->
		case method(Arg) of
			'GET' -> 	io_lib:format("{\"title\": \"Arrivato messaggio in GET\", \"method\": \"get\", \"result\": ~p }", ["test get"]);

			'POST' -> 	io_lib:format("{\"title\": \"Arrivato messaggio in POST\", \"method\": \"POST\", \"result\": ~p }", [get_data(Arg)])
			%'POST' -> 	io_lib:format("{\"title\": \"Arrivato messaggio in POST\", \"method\": \"POST\", \"result\": ~p }", [Arg#arg.clidata])
			%'POST' -> 	io_lib:format("{\"title\": \"Arrivato messaggio in POST\", \"method\": \"POST\", \"result\": ~p }", ["[{\"prova\": \"valore\", \"prova2\": \"valore2\" }]"])
			%'POST' ->	io_lib:format("{\"title\": \"Arrivato messaggio in post\", \"method\": \"post\",  \"post\": ~p }", [rfc4627:decode("[{\"prova\": \"valore\"; \"prova2\": \"valore2\" }]")])
			%'POST' ->	
			%			data = Arg#arg.clidata, %rfc4627:decode(Arg#arg.clidata),
			%			io_lib:format("{\"title\": \"Arrivato messaggio in post\", \"method\": \"post\",  \"post\": ~p }", ["[{\"prova\": \"valore\"; \"prova2\": \"valore2\" }]"])
		end
	.
	
	method(Arg) ->  
		Rec = Arg#arg.req,   Rec#http_request.method
		. 

	processa_comandi('POST', Arg) ->
		%Result = "risultato",
		Parametri = #{
			<<"title">> => <<"Arrivato messaggio in POST">>,
			<<"method">> => <<"POST">>,
			<<"result">> => 
				try 
					get_data(Arg)
				catch
					_:_ -> <<"result_error">>
				end,
			<<"risposta">> => 
				try 
					process_data_2(Arg)
				catch
					_:_ -> <<"process_data_error">>
				end
		},
		Result = json:encode(Parametri),
		%Result = io_lib:format("{\"title\": \"Arrivato messaggio in POST\", \"method\": \"POST\", \"result\": ~p }", [get_data(Arg)]),
		Result
		;

	processa_comandi('GET', _Arg) ->
		%equivalente con le mappe di quello fatto fino ad ora
		Parametri = #{
			<<"title">> => <<"Arrivato messaggio in GET">>,
			<<"method">> => <<"GET">>,
			<<"result">> => <<"test_get">>
		},
		Result = json:encode(Parametri),
		%Result = io_lib:format("{\"title\": \"Arrivato messaggio in GET\", \"method\": \"get\", \"result\": ~p }", ["test_get"]),
		Result
		;
	
	processa_comandi(Method, Arg) ->
		Result = io_lib:format("Metodo non gestito: ~p", [Method]),
		Result
		.

	get_data(Arg) ->
		Clidata = Arg#arg.clidata,
		{_, Parametri} = decode_Json(Clidata), 
		%{ok, Jsondata, _} = rfc4627:decode(Clidata),
		%Msgtype = rfc4627:get_field(Jsondata, "msg-type", <<>>),
		%Result = io:format("~p", [Msg_Type]),
		%Result = Clidata, %"test4",
		Parametri
		.

	process_data_2(Arg) ->
		Clidata = Arg#arg.clidata,
		Parametri__ =
		#{	<<"msg_type">> => <<"test_messaggio">>,
			<<"numero_iterazioni">> => 1,
			<<"test">> => <<"Sara">>},
		Parametri =
			try 
				json:decode(Clidata)
			catch
				_:_ -> #{<<"msg_type">> => <<"decode_json_problem">>} 
			end,
%		ParametriTuple = yaws_api:parse_post(Arg),
%		Parametri___ = maps:from_list(ParametriTuple),
		%TipoMessaggio = maps:get(<<"test">>, Parametri, <<"default_value">>),
		TipoMessaggio = try 
			#{<<"msg_type">> := M} = Parametri,
			%#{<<"test">> := M} = Parametri,
			M  %% Se il match riesce, Messaggio diventerà il valore di M
		catch 
			error:{badmatch, _} ->
				%list_to_binary("tipo_sconosciuto: is_map: " ++ Clidata)
				%list_to_binary("tipo_sconosciuto: is_map: " ++ atom_to_binary(is_map(Parametri), utf8) ++ Clidata)
				%list_to_binary("tipo_sconosciuto: " ++ Parametri ++ "is_map: "++ is_map(Parametri))
				%list_to_binary("tipo_sconosciuto: is_map: " ++ is_map(Parametri))
				<<"tipo_sconosciuto">> %% Valore di default se la chiave manca
		end,
		case TipoMessaggio of
			<<"test_messaggio">> ->
				Parametri_res = #{
					<<"result-type">> => <<"test_result">>,
					<<"result">> => <<"result successfull">>
				};
			<<"registra_postazione">> ->
				Parametri_res = #{
					<<"result-type">> => <<"registration_result">>,
					<<"result">> => <<"registration successfull">>
				};
				%Result = json:encode(Parametri),
			_ -> 
				Parametri_res = #{
					<<"result-type">> => <<"not_found">>,
					<<"result">> => TipoMessaggio
				}
		end,
		Parametri_res
		.	
			
	process_data(Arg) ->
		Clidata = iolist_to_binary(Arg#arg.clidata),
%		{_, Parametri_} = 
%			try 
%				decode_Json(Clidata)
%			catch
%				_:_ -> { error, <<"decode_json_problem">> }
%			end,
		Parametri =
			try 
				json:decode(Clidata)
			catch
				_:_ -> #{<<"msg_type">> => <<"decode_json_problem">>} 
			end,
		
		%{ok, Messaggio2} = json:get_field(Parametri_in, "msg-type"),
		Tipo_Messaggio = maps:get(<<"msg_type">>, Parametri, <<"default_value">>),
		% Estraiamo il campo 'studente' in una variabile
%		Tipo_Messaggio = try 
%			%#{<<"msg_type">> := M} = Parametri,
%			#{<<"test">> := M} = Parametri,
%			M  %% Se il match riesce, Messaggio diventerà il valore di M
%		catch 
%			error:{badmatch, _} ->
%				list_to_binary("tipo_sconosciuto: " ++ json:encode(Parametri))
%				%<<"tipo_sconosciuto">> %% Valore di default se la chiave manca
%		end,
		%#{<<"msg_type">> := Tipo_Messaggio_2} = Parametri,
		%Messaggio = list_to_binary(json:encode(Parametri_in)),
		%Tipo_Messaggio = list_to_binary(json:encode(Tipo_Messaggio_2)),
		%Tipo_Messaggio = <<"test_messaggio">>,
		case Tipo_Messaggio of
			<<"test_messaggio">> ->
				Parametri_res = #{
					<<"result-type">> => <<"test_result">>,
					<<"result">> => <<"result successfull">>
				};
			<<"registra_postazione">> ->
				Parametri_res = #{
					<<"result-type">> => <<"registration_result">>,
					<<"result">> => <<"registration successfull">>
				};
				%Result = json:encode(Parametri),
			_ -> 
				Parametri_res = #{
					<<"result-type">> => <<"not_found">>,
					<<"result">> => Tipo_Messaggio
				}
		end,
		%Messaggio = <<"messaggio2a">>,
		%Parametri = #{
		%	<<"result-type">> => <<"test_result">>,
		%	<<"result">> => <<"result successfull">>,
		%	<<"msg_arrived_numelements">> => maps:size(Parametri_in),
		%	%<<"msg_arrived_numelements">> => is_map(Parametri_in),
		%	<<"msg_arrived">> => Messaggio
		%},
		%Result = json:encode(Parametri),
		Parametri_res
		.

	get_data2(Arg) ->  
		{ok, Json, _}  = rfc4627:decode(Arg#arg.clidata),
		io:format("~n~p:~p POST request ~p~n", [?MODULE, ?LINE, Json])
		.

	decode_Json(JsonRaw) ->
		Mappa = 
		try
			json:decode(JsonRaw)
		catch
			%error:Reason ->
				%io:format("Errore durante la decodifica JSON: ~p~n", [Reason]),
				%{error, #{<<"errore">> => <<"json_malformato">>} }
			_:_ -> #{<<"msg_type">> => <<"errore">>}
		end,
		{ok, Mappa}
		.
%		case json:decode(JsonRaw) of
%			{ok, {obj, Dati}, _} ->
%				% Estraiamo un valore specifico (es. lo studente)
%				%{ok, Studente} = rfc4627:get_field({obj, Dati}, "studente"),
%				%{ok, Studente} = json:get_field({obj, Dati}, "studente"),
%				#{<<"studente">> := Studente} = Dati,
%				
%				% Qui chiameresti il tuo "Gestore di messaggi" per salvare i dati
%				%io:format("Ricevuti risultati per lo studente: ~p~n", [Studente]),
%				
%				% 4. Rispondiamo al client con un messaggio di successo
%				Risposta = json:encode({obj, [{"status", "ok"}, {"msg", "Ricevuto!"}]}),
%				{content, "application/json", Risposta};
%
%			{unexpected_byte, Byte, Position} ->
%				% Gestione errore se il JSON è malformato
%				{status, 400};
%			{unexpected_end, Position} ->
%				% Gestione errore se il JSON è malformato
%				{status, 400};
%			invalid_utf8 ->
%				{status, 400}
%		end	 		
%		.

	out(Arg) ->
		Method = method(Arg),
		Risultato = try
			processa_comandi(Method, Arg)
		catch
			_ -> json:encode(#{
			<<"title">> => <<"Arrivato messaggio in POST">>,
			<<"method">> => <<"POST">>
		})
		end,
		%Risultato = "processa_comandi(Method, Arg)",
		%{ehtml, Risultato}
		
		%% Definiamo l'header CORS
		% Sostituisci "*" con "https://tuosito.com" per maggiore sicurezza
		ACAO = {header, {"Access-Control-Allow-Origin", "*"}},
		
		%% Altri header comuni per le API
		%ContentType = {header, {"Content-Type", "application/json"}},
		% Torno gli header per evitare ACAO
		[
			ACAO,
			%ContentType,		
			{content, "application/json", Risultato}
		]
		.   
		%{ehtml, test_reply(Arg)}.
		%{ehtml, f("{\"title\": \"title\", \"method\": \"~p\" }", [method(Arg)])}.  
		%msg_func:test_reply(Arg).
		%{ehtml, f("{\"title\": \"title\", \"post\": \"~p\" }", [yaws_api:parse_post(Arg)])}.  

</erl>
